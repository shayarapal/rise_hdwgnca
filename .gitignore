# Data — never commit Seurat objects, raw counts, or results.
# As of 2026-09-06 the datasets live OUTSIDE this repo, in the directory named by
# SHARED_DIR (see .env.example). These rules are kept as a safety net so that a stray
# download into the repo is still ignored.
*.h5Seurat
*.h5Seurat.old
*.h5ad
*.loom
*.rds
*.tar
*.mtx
*.mtx.gz
local_data/

# GSE243639 (~5.6 GB: 29 samples of raw 10x counts + built Seurat objects).
# Download from GEO into $SHARED_DIR/DATA_UNZIPPED/; rebuild with build_seurat_GSE243639.R.
# The build scripts themselves ARE tracked — everything else in here is not.
DATA_UNZIPPED/*
!DATA_UNZIPPED/*.R
GSE243639_Clinical_data.csv
hdwgcna_out/

# GSE233866 (mouse SNc/VTA atlas, ~9.9 GB raw counts + built Seurat objects).
# Download from GEO into $SHARED_DIR/DATA_GSE233866/; rebuild with build_seurat_GSE233866.R.
DATA_GSE233866/*
!DATA_GSE233866/*.R

# Analysis outputs moved to $SHARED_DIR/analysis_results/ on 2026-09-06 and untracked
# since. Earlier revisions remain in git history (git checkout 446ce5f -- analysis_results/).
analysis_results/

# OS
.DS_Store
Thumbs.db

# Copy to .env for local development (never commit .env)

# URL the Python backend uses to reach the R plumber service
R_SERVICE_URL=http://localhost:8100

# Ports each service listens on locally
R_SERVICE_PORT=8100
BACKEND_PORT=8200

# Host directory bind-mounted at /shared in both containers, and the local equivalent
# for the non-Docker flow. Keep it OUTSIDE this repository: it holds the 10-20 GB of raw
# counts and built Seurat objects, plus the per-study R analysis scripts. None of that is
# tracked here — this repo is the hdWGCNA HTTP bridge only.
#
# It must contain DATA_GSE233866/ and DATA_UNZIPPED/ under exactly those names, because
# the scripts address data as /shared/DATA_GSE233866/<file>. Download the raw data from
# GEO (GSE233866, GSE243639) and place the analysis .R scripts in the matching subdirs.
SHARED_DIR=C:/projects/rise_hdwgnca_data

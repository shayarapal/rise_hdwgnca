# Copy to .env for local development (never commit .env)

# URL the Python backend uses to reach the R plumber service
R_SERVICE_URL=http://localhost:8100

# Ports each service listens on locally
R_SERVICE_PORT=8100
BACKEND_PORT=8200

# Local equivalent of the /shared Docker volume
# Create this directory and put your .h5Seurat files inside it
SHARED_DIR=./local_data
